/*
  Content-Security-Policy: default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' blob: data:; connect-src 'self' https://*.trycloudflare.com wss://*.trycloudflare.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/gateway-config.js
  Cache-Control: no-store

/app.js
  Cache-Control: public, max-age=300, must-revalidate

/styles.css
  Cache-Control: public, max-age=300, must-revalidate
